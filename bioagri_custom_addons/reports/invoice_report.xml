<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hereda de la plantilla base de account, NO de l10n_ar -->
    <template id="report_invoice_document_bioagri"
              inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='total']" position="before">
            <div t-if="o.x_percepcion_iibb > 0" class="mb-2 text-end">
                <strong>Percepción IIBB: </strong>
                <span t-out="o.x_percepcion_iibb"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </div>
        </xpath>
    </template>
</odoo>
