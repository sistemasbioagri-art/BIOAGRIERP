<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_bioagri"
              inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='total']//table/t[@t-call='account.document_tax_totals']" position="before">
            <tr t-if="o.x_percepcion_iibb > 0">
                <td><span>Percepción IIBB</span></td>
                <td class="text-end">
                    <span t-out="o.x_percepcion_iibb"
                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                </td>
            </tr>
        </xpath>

        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'" style="color: #2E7D32; font-weight: bold;">FACTURA</span>
                <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'" style="color: #2E7D32; font-weight: bold;">NOTA DE CREDITO</span>
                <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'" style="color: #2E7D32; font-weight: bold;">BORRADOR</span>
                <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'" style="color: #2E7D32; font-weight: bold;">BORRADOR NOTA DE CREDITO</span>
                <br/>
                <span t-if="o.name and o.name != '/'" t-field="o.name" style="font-size: 14px; color: #666;">INV/2023/0001</span>
            </t>
        </xpath>
    </template>
</odoo>
