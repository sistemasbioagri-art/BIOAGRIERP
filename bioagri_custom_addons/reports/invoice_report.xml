<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hereda de la plantilla base de account, NO de l10n_ar -->
    <template id="report_invoice_document_bioagri"
              inherit_id="account.report_invoice">
        <xpath expr="//div[@id='total']//tr[@class='o_subtotal']" position="before">
            <tr class="o_percepcion_iibb">
                <td><span>Percepción IIBB</span></td>
                <td class="text-end">
                    <span t-out="o.x_percepcion_iibb"
                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
