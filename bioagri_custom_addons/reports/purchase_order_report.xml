<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_bioagri"
              inherit_id="purchase.report_purchaseorder_document">
        
        <!-- 1. Supplier code column -->
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_supplier_code" class="text-center">Cod. Proveedor</th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td name="td_supplier_code" class="text-center">
                <t t-set="supplier_info" t-value="line.product_id.seller_ids.filtered(lambda s: s.partner_id == o.partner_id)[:1]"/>
                <t t-if="supplier_info">
                    <span t-field="supplier_info.product_code"/>
                </t>
            </td>
        </xpath>

        <!-- 2. Remove # from title -->
        <xpath expr="//t[@t-if=&quot;o.state in ['draft', 'sent', 'to approve']&quot;]" position="replace">
            <t t-if="o.state in ['draft', 'sent', 'to approve']">Pedido de Compra <span t-field="o.name"/></t>
        </xpath>
        <xpath expr="//t[@t-if=&quot;o.state in ['purchase', 'done']&quot;]" position="replace">
            <t t-if="o.state in ['purchase', 'done']">Orden de Compra <span t-field="o.name"/></t>
        </xpath>
        <xpath expr="//t[@t-if=&quot;o.state == 'cancel'&quot;]" position="replace">
            <t t-if="o.state == 'cancel'">Orden de Compra Cancelada <span t-field="o.name"/></t>
        </xpath>

        <!-- 3. Show currency in table headers -->
        <xpath expr="//th[@name='th_price_unit']" position="replace">
            <th name="th_price_unit" class="text-end">
                <strong>Precio Unitario (<span t-field="o.currency_id.name"/>)</strong>
            </th>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="replace">
            <th name="th_subtotal" class="text-end">
                <strong>Importe (<span t-field="o.currency_id.name"/>)</strong>
            </th>
        </xpath>

        <!-- 4. Exchange rate and ARS total at bottom left -->
        <xpath expr="//t[@t-call='purchase.document_tax_totals']" position="before">
            <div class="row mb-2" t-if="o.currency_id != o.company_id.currency_id">
                <div class="col-6">
                    <strong>Moneda de la orden:</strong> <span t-field="o.currency_id.name"/> (<span t-field="o.currency_id.symbol"/>)<br/>
                    <strong>Tipo de cambio:</strong> <span t-field="o.x_currency_rate"/> <span t-field="o.currency_id.symbol"/> = 1 <span t-field="o.company_id.currency_id.symbol"/><br/>
                    <strong>Total en <span t-field="o.company_id.currency_id.name"/>:</strong> <span t-field="o.x_amount_total_ars"/>
                </div>
            </div>
        </xpath>

    </template>
</odoo>
