<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_bioagri"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_supplier_code">Código Proveedor</th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td name="td_supplier_code">
                <t t-if="line.product_id.seller_ids">
                    <span t-field="line.product_id.seller_ids[0].product_code"/>
                </t>
            </td>
        </xpath>
    </template>
</odoo>
