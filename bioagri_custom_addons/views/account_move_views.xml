<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_bioagri" model="ir.ui.view">
        <field name="name">account.move.form.bioagri</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoice_line']" position="inside">
                <group>
                    <group>
                        <label for="x_percepcion_iibb" string="Percepción IIBB"/>
                        <field name="x_percepcion_iibb" readonly="1" invisible="move_type != 'out_invoice'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
