<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_bioagri" model="ir.ui.view">
        <field name="name">account.move.form.bioagri</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoice_tab']" position="inside">
                <div class="row mb-3 mt-3" invisible="move_type != 'out_invoice'">
                    <div class="col-4"><strong>Percepcion IIBB:</strong></div>
                    <div class="col-8">
                        <field name="x_percepcion_iibb" readonly="1"/>
                    </div>
                </div>
                <div class="row mb-3 mt-3" invisible="move_type != 'in_invoice'">
                    <div class="col-4"><strong>Remito / Importacion:</strong></div>
                    <div class="col-8">
                        <field name="x_picking_id"/>
                        <span class="text-muted" style="font-size: 11px;">Vincule esta factura de gasto a un remito para crear Costo en Destino.</span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
