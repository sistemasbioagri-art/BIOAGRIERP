<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_bioagri" model="ir.ui.view">
        <field name="name">account.payment.form.bioagri</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="x_base_retencion" attrs="{'invisible': [('x_base_retencion', '=', 0)]}"/>
                <field name="x_retencion_ganancias" attrs="{'invisible': [('x_retencion_ganancias', '=', 0)]}"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_bioagri" model="ir.ui.view">
        <field name="name">account.payment.search.bioagri</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <filter name="group_by_partner" position="after">
                <filter name="filter_sire_pending" string="Pendientes SIRE"
                        domain="[('x_sire_exported', '=', False), ('x_retencion_ganancias', '>', 0)]"/>
            </filter>
        </field>
    </record>

    <record id="action_export_sire_txt" model="ir.actions.server">
        <field name="name">Exportar SIRE (.txt)</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="state">code</field>
        <field name="code">action = records.action_generate_sire_txt()</field>
    </record>
</odoo>
