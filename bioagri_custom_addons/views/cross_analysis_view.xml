<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bioagri_cross_analysis_tree" model="ir.ui.view">
        <field name="name">bioagri.cross.analysis.tree</field>
        <field name="model">bioagri.cross.analysis</field>
        <field name="arch" type="xml">
            <tree string="Informe Cruzado Bioagri">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="qty_ordered" sum="Cant. Pedida"/>
                <field name="qty_delivered" sum="Cant. Entregada"/>
                <field name="qty_invoiced" sum="Cant. Facturada"/>
                <field name="qty_pending_delivery" sum="Pend. Entrega"/>
                <field name="qty_pending_invoice" sum="Pend. Facturar"/>
            </tree>
        </field>
    </record>

    <record id="view_bioagri_cross_analysis_pivot" model="ir.ui.view">
        <field name="name">bioagri.cross.analysis.pivot</field>
        <field name="model">bioagri.cross.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Informe Cruzado Bioagri">
                <field name="partner_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="qty_ordered" type="measure"/>
                <field name="qty_delivered" type="measure"/>
                <field name="qty_invoiced" type="measure"/>
                <field name="qty_pending_delivery" type="measure"/>
                <field name="qty_pending_invoice" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_bioagri_cross_analysis_graph" model="ir.ui.view">
        <field name="name">bioagri.cross.analysis.graph</field>
        <field name="model">bioagri.cross.analysis</field>
        <field name="arch" type="xml">
            <graph string="Informe Cruzado Bioagri" type="bar">
                <field name="partner_id"/>
                <field name="qty_ordered" type="measure"/>
                <field name="qty_delivered" type="measure"/>
                <field name="qty_invoiced" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_bioagri_cross_analysis" model="ir.actions.act_window">
        <field name="name">Informe Cruzado Bioagri</field>
        <field name="res_model">bioagri.cross.analysis</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="help">Reporte unificado de ventas: muestra cantidades pedidas, entregadas y facturadas por cliente y producto.</field>
    </record>

    <menuitem id="menu_bioagri_cross_analysis"
              name="Informe Cruzado"
              parent="sale.menu_sale_report"
              action="action_bioagri_cross_analysis"
              sequence="50"/>
</odoo>
