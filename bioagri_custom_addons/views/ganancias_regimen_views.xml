<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ganancias_regimen_form" model="ir.ui.view">
        <field name="name">x_ganancias.regimen.form</field>
        <field name="model">x_ganancias.regimen</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" placeholder="Código"/>
                            <field name="name" placeholder="Descripción"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuración">
                            <field name="minimo_no_imponible"/>
                            <field name="alicuota_fija"/>
                            <field name="usa_escala"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Escalas Progresivas" invisible="not usa_escala">
                            <field name="escala_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ganancias_regimen_list" model="ir.ui.view">
        <field name="name">x_ganancias.regimen.list</field>
        <field name="model">x_ganancias.regimen</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="minimo_no_imponible"/>
                <field name="alicuota_fija"/>
                <field name="usa_escala"/>
            </list>
        </field>
    </record>

    <record id="action_ganancias_regimen" model="ir.actions.act_window">
        <field name="name">Regímenes de Ganancias</field>
        <field name="res_model">x_ganancias.regimen</field>
        <field name="view_mode">form,list</field>
    </record>

    <menuitem
        id="menu_ganancias_regimen"
        name="Regímenes de Ganancias"
        parent="account.menu_finance_configuration"
        action="action_ganancias_regimen"
        sequence="100"/>
</odoo>
