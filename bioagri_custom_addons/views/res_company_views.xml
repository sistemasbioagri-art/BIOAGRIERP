<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_bioagri" model="ir.ui.view">
        <field name="name">res.company.form.bioagri</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting']" position="inside">
                <group name="bioagri_retenciones" string="Retenciones de Ganancias">
                    <field name="x_agente_retencion_ganancias"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
