<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arba_padron_import_wizard" model="ir.ui.view">
        <field name="name">arba.padron.import.wizard.form</field>
        <field name="model">arba.padron.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Padron ARBA">
                <group>
                    <field name="tipo"/>
                    <field name="separador"/>
                    <field name="archivo" widget="padron_uploader"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_arba_padron_import_form" model="ir.ui.view">
        <field name="name">arba.padron.import.form</field>
        <field name="model">arba.padron.import</field>
        <field name="arch" type="xml">
            <form string="Resultado de Importación">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tipo"/>
                        <field name="fecha_vigencia"/>
                        <field name="count_total"/>
                        <field name="count_updated"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="cuit"/>
                            <field name="partner_id"/>
                            <field name="alicuota_anterior"/>
                            <field name="alicuota_nueva"/>
                            <field name="updated"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_arba_padron_import_tree" model="ir.ui.view">
        <field name="name">arba.padron.import.tree</field>
        <field name="model">arba.padron.import</field>
        <field name="arch" type="xml">
            <list string="Importaciones de Padrón ARBA">
                <field name="name"/>
                <field name="tipo"/>
                <field name="fecha_vigencia"/>
                <field name="count_total"/>
                <field name="count_updated"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_arba_padron_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Padron ARBA</field>
        <field name="res_model">arba.padron.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_arba_padron_import" model="ir.actions.act_window">
        <field name="name">Importaciones de Padrón</field>
        <field name="res_model">arba.padron.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_arba_padron_import"
              name="Importar Padron ARBA"
              parent="account.menu_finance_configuration"
              action="action_arba_padron_import_wizard"
              sequence="99"/>
    <menuitem id="menu_arba_padron_history"
              name="Historial de Importaciones ARBA"
              parent="account.menu_finance_configuration"
              action="action_arba_padron_import"
              sequence="100"/>
</odoo>
